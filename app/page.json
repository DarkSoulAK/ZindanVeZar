'use client';
import { useState } from 'react';

export default function Home() {
  const [character, setCharacter] = useState({ name: '', race: 'İnsan', class_name: 'Savaşçı', hp: 100, max_hp: 100, inventory: ['Pirinç Hançer', '50 Altın'] });
  const [input, setInput] = useState('');
  const [history, setHistory] = useState([{ role: 'assistant', content: 'Zindan & Zar Tavernasına hoş geldin maceracı! Ne yapmak istiyorsun?' }]);
  const [loading, setLoading] = useState(false);

  const sendAction = async () => {
    if (!input.trim() || loading) return;
    setLoading(true);
    const newHistory = [...history, { role: 'user', content: input }];
    setHistory(newHistory);
    setInput('');

    try {
      const res = await fetch('/api/game', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ playerInput: input, gameHistory: history, character })
      });
      const data = await res.json();
      setHistory([...newHistory, { role: 'assistant', content: data.response }]);
    } catch (e) {
      alert("Hata oluştu!");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div style={{ padding: 20, background: '#0d0d0f', color: '#fff', minHeight: '100vh', fontFamily: 'sans-serif' }}>
      <h1>🎲 Zindan & Zar - Türkçe RPG</h1>
      <div style={{ height: '400px', overflowY: 'auto', border: '1px solid #333', padding: 15, margin: '20px 0', background: '#141419' }}>
        {history.map((m, i) => (
          <p key={i} style={{ color: m.role === 'user' ? '#00ffcc' : '#f1c40f', marginBottom: 10 }}>
            <strong>{m.role === 'user' ? 'Sen: ' : 'DM: '}</strong>{m.content}
          </p>
        ))}
        {loading && <p style={{ color: '#888' }}>DM düşünüyor ve zar atıyor...</p>}
      </div>
      <input 
        value={input} 
        onChange={(e) => setInput(e.target.value)} 
        onKeyDown={(e) => e.key === 'Enter' && sendAction()}
        placeholder="Hamleni yaz (Örn: Kapıyı zorlayıp içeri giriyorum)" 
        style={{ width: '80%', padding: 12, background: '#1e1e24', color: '#fff', border: '1px solid #444' }}
      />
      <button onClick={sendAction} style={{ padding: '12px 20px', background: '#f1c40f', border: 'none', fontWeight: 'bold', cursor: 'pointer', marginLeft: 10 }}>Gönder</button>
    </div>
  );
}